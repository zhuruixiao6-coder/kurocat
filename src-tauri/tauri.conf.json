{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuroCat",
  "version": "5.9.16",
  "identifier": "com.kurocat.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KuroCat",
        "width": 420,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "zhuruixiao6-coder",
    "shortDescription": "KuroCat 桌面打字猫：键盘可视化、配饰、皮肤与音效",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "headerImage": "icons/nsis-header.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "section": "utility"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "longDescription": "KuroCat 是一个桌面打字猫伴侣：实时键盘可视化、3D 配饰、可换皮肤与轴体音效。所有数据仅保存在本机，不采集、不上传按键内容。",
    "copyright": "Copyright (c) 2026 KuroCat Contributors / zhuruixiao6-coder"
  }
}